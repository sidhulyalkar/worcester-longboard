  "universal_stop_conditions": [
    "unexpected propulsion with zero command",
    "remote_deadman_or_stale-command behavior not fail-conservative",
    "mechanical brake unavailable or materially degraded",
    "wheel_retention_change or critical witness movement",
    "structural crack permanent deformation or mount motion",
    "unexpected steering/yaw torque",
    "current voltage ERPM or temperature exceeds declared stage stop limit",
    "sensor disagreement that invalidates control or safety measurement",
    "connector harness cable brake or guard enters moving sweep",
    "abnormal vibration grinding noise smoke odor or rapid heating",
    "new lifecycle STOP_USE finding"
  ],
  "lineage_rules": [
    "Every stage report links the exact final power-architecture fingerprint.",
    "Every stage report links a fresh READY lifecycle-health fingerprint for the same configuration.",
    "Stage 1 through Stage 4 link the immediately preceding stage fingerprint.",
    "Stage 3 and Stage 4 link a qualified powered-test venue fingerprint.",
    "A configuration change invalidates downstream commissioning lineage until the affected stages are repeated.",
    "A lifecycle STOP_USE or SERVICE_REQUIRED state invalidates progression until explicitly closed and followed by a fresh preflight.",
    "A stage may not be skipped.",
    "Stage 1 through Stage 4 link a fingerprinted telemetry replay authority derived from sealed raw telemetry for the exact board/configuration/power architecture/stage."
  ],
  "authority_boundaries": [
    "Stage reports qualify only the declared commissioning stage.",
    "No Stage 0-4 report grants general powered-operation authority.",
    "No commissioning stage grants public-operation authority.",
    "No commissioning stage grants dog-accompanied-operation authority.",
    "Stage 4 completion is rider-only commissioning evidence, not permission for normal riding.",
    "Regen remains supplemental to independent mechanical stopping.",
    "Venue authority qualifies the location only and never substitutes for vehicle-stage evidence."
  ],
  "general_powered_operation_authorized": false,
