        {
          "id": "terrain_pavement",
          "label": "Pavement",
          "type": "range",
          "required": true,
          "quick": false,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 20,
          "unit": "%"
        },
        {
          "id": "terrain_packed_dirt",
          "label": "Packed dirt",
          "type": "range",
          "required": true,
          "quick": true,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 35,
          "unit": "%"
