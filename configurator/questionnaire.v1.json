        {
          "id": "hill_profile",
          "label": "Hills",
          "type": "select",
          "required": true,
          "quick": true,
          "default": "rolling",
          "options": [
            [
              "flat",
              "Mostly flat"
            ],
            [
              "rolling",
              "Rolling / moderate"
            ],
            [
              "steep",
              "Frequent steep grades"
            ],
            [
              "long_descents",
              "Long sustained descents"
            ]
          ]
        },
        {
          "id": "wet_exposure",
          "label": "Wet / splash exposure",
          "type": "select",
          "required": true,
          "quick": false,
          "default": "occasional",
          "options": [
            [
              "never",
              "Dry only"
            ],
            [
              "occasional",
              "Occasional splash / damp trail"
            ],
            [
              "frequent",
              "Frequent wet / muddy conditions"
            ]
          ]
        },
        {
          "id": "jumps_drops",
          "label": "Jumps / drops",
          "type": "select",
          "required": true,
          "quick": false,
          "default": "small",
          "options": [
            [
              "none",
              "None"
            ],
            [
              "small",
              "Small trail hops"
            ],
            [
              "moderate",
              "Moderate jumps / drops"
            ],
            [
              "aggressive",
              "Aggressive airtime"
            ]
          ]
        }
      ]
    },
    {
      "id": "feel",
