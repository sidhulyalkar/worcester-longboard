          "type": "range",
          "required": true,
          "quick": true,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 25,
          "unit": "%"
        },
        {
          "id": "terrain_roots_rocks",
          "label": "Roots / rocks",
          "type": "range",
          "required": true,
          "quick": true,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 15,
          "unit": "%"
        },
        {
          "id": "terrain_grass_brush",
          "label": "Grass / brush",
          "type": "range",
          "required": true,
          "quick": false,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 5,
          "unit": "%"
