{
  "schema_version": 1,
  "product": "Worcester Board Builder",
  "note": "Questionnaire definitions only. Unknown values remain explicit and are not physical authority.",
  "sections": [
    {
      "id": "rider",
      "label": "Rider",
      "summary": "Your body sets the starting ergonomic and load envelope.",
      "fields": [
        {
          "id": "height_in",
          "label": "Height",
          "type": "number",
          "required": true,
          "quick": true,
          "min": 48,
          "max": 84,
          "step": 1,
          "unit": "in",
          "default": 68,
          "help": "Used only to seed an adjustable stance study range."
        },
        {
          "id": "weight_lb",
          "label": "Body weight",
          "type": "number",
          "required": true,
          "quick": true,
          "min": 70,
          "max": 350,
          "step": 1,
          "unit": "lb",
          "default": 170,
          "help": "Combined with carried load for planning mass."
        },
        {
          "id": "cargo_lb",
          "label": "Typical backpack / carried load",
          "type": "number",
          "required": false,
          "quick": false,
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "lb",
          "default": 5
        },
        {
          "id": "stance",
          "label": "Stance",
          "type": "select",
          "required": true,
          "quick": true,
          "default": "unknown",
          "options": [
            [
              "regular",
              "Regular"
            ],
            [
              "goofy",
              "Goofy"
            ],
            [
              "unknown",
              "Not sure / either"
            ]
          ]
        },
        {
          "id": "shoe_left_us",
          "label": "Left shoe size",
          "type": "number",
          "required": false,
          "quick": false,
          "min": 2,
          "max": 16,
          "step": 0.5,
          "unit": "US",
          "default": null
        },
        {
          "id": "shoe_right_us",
          "label": "Right shoe size",
          "type": "number",
          "required": false,
          "quick": false,
          "min": 2,
          "max": 16,
          "step": 0.5,
          "unit": "US",
          "default": null
        },
        {
          "id": "stance_width_mm",
          "label": "Known comfortable stance width",
          "type": "number",
          "required": false,
          "quick": false,
          "min": 260,
          "max": 520,
          "step": 5,
          "unit": "mm",
          "default": null,
          "help": "Leave blank if unknown; the builder will create an adjustable study range."
        },
        {
          "id": "fit_notes",
          "label": "Fit / mobility notes",
          "type": "text",
          "required": false,
          "quick": false,
          "default": "",
          "help": "Optional free text. Kept local in the browser unless you explicitly export the profile."
        }
      ]
    },
    {
      "id": "experience",
      "label": "Experience",
      "summary": "Experience changes how strongly we weight stability, responsiveness and speed margin.",
      "fields": [
        {
          "id": "board_experience",
          "label": "Skate / longboard experience",
          "type": "select",
          "required": true,
          "quick": true,
          "default": "intermediate",
          "options": [
            [
              "none",
              "None"
            ],
            [
              "beginner",
              "Beginner"
            ],
            [
              "intermediate",
              "Intermediate"
            ],
            [
              "advanced",
              "Advanced"
            ],
            [
              "expert",
              "Expert"
            ]
          ]
        },
        {
          "id": "snowboard_experience",
          "label": "Snowboard experience",
          "type": "select",
          "required": true,
          "quick": false,
          "default": "intermediate",
          "options": [
            [
              "none",
              "None"
            ],
            [
              "beginner",
              "Beginner"
            ],
            [
              "intermediate",
              "Intermediate"
            ],
            [
              "advanced",
              "Advanced"
            ],
            [
              "expert",
              "Expert"
            ]
          ]
        },
        {
          "id": "speed_comfort",
          "label": "Comfort with speed",
          "type": "range",
          "required": true,
          "quick": false,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 45,
          "left_label": "Conservative",
          "right_label": "Very comfortable"
        }
      ]
    },
    {
      "id": "mission",
      "label": "Mission",
      "summary": "How far, how fast, and how often you expect to ride.",
      "fields": [
        {
          "id": "electric_propulsion",
          "label": "Electric propulsion",
          "type": "select",
          "required": true,
          "quick": true,
          "default": "yes",
          "options": [
            [
              "yes",
              "Yes"
            ],
            [
              "eventually",
              "Eventually / design for it"
            ],
            [
              "no",
              "No, unpowered board"
            ]
          ]
        },
        {
          "id": "typical_miles",
          "label": "Typical ride",
          "type": "number",
          "required": true,
          "quick": true,
          "min": 1,
          "max": 80,
          "step": 1,
          "unit": "mi",
          "default": 10
        },
        {
          "id": "longest_miles",
          "label": "Longest desired ride",
          "type": "number",
          "required": true,
          "quick": true,
          "min": 1,
          "max": 120,
          "step": 1,
          "unit": "mi",
          "default": 18
        },
        {
          "id": "cruise_mph",
          "label": "Preferred cruise",
          "type": "number",
          "required": true,
          "quick": false,
          "min": 5,
          "max": 30,
          "step": 1,
          "unit": "mph",
          "default": 14
        },
        {
          "id": "speed_ceiling_mph",
          "label": "Desired speed ceiling",
          "type": "number",
          "required": true,
          "quick": true,
          "min": 8,
          "max": 35,
          "step": 1,
          "unit": "mph",
          "default": 20
        },
        {
          "id": "recharge_hours",
          "label": "Desired recharge time",
          "type": "number",
          "required": false,
          "quick": false,
          "min": 1,
          "max": 12,
          "step": 0.5,
          "unit": "h",
          "default": 5
        },
        {
          "id": "stop_start",
          "label": "Frequent stop / start riding",
          "type": "boolean",
          "required": false,
          "quick": false,
          "default": false
        }
      ]
    },
    {
      "id": "terrain",
