    {
      "id": "constraints",
      "label": "Constraints",
      "summary": "Budget, portability and maintenance determine which attractive designs are actually useful.",
      "fields": [
        {
          "id": "budget_usd",
          "label": "Target parts budget",
          "type": "number",
          "required": true,
          "quick": true,
          "min": 400,
          "max": 5000,
          "step": 50,
          "unit": "USD",
          "default": 1600
        },
        {
          "id": "hard_budget_usd",
