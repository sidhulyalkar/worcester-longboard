          "required": true,
          "quick": true,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 80,
          "left_label": "Skate-like",
          "right_label": "Snowboard-like"
        },
        {
          "id": "stability_preference",
          "label": "Stability",
          "type": "range",
          "required": true,
          "quick": true,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 70,
          "left_label": "Playful",
          "right_label": "Locked-in"
        },
        {
          "id": "compliance_preference",
          "label": "Ride compliance",
          "type": "range",
          "required": true,
          "quick": false,
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 70,
          "left_label": "Direct",
          "right_label": "Plush"
