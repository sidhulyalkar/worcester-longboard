{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worcester-x1.local/schemas/board_candidate.schema.json",
  "title": "Generated board candidate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "label",
    "vendor_family",
    "fit_score",
    "readiness",
    "architecture_id",
    "bom",
    "explanations",
    "blockers",
    "unknowns",
    "personalized_spec",
    "preference_fit"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "fit_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "readiness": {
      "enum": [
        "REFERENCE_COMPATIBLE",
        "MEASURE_FIRST",
        "BLOCKED",
        "INCOMPATIBLE"
      ]
    },
    "architecture_id": {
      "type": "string"
    },
    "bom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "explanations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_preset": {
      "type": "string"
    },
    "preference_fit": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "personalized_spec": {
      "type": "object",
      "required": [
        "target_range_mi",
        "planning_installed_energy_wh",
        "selected_energy_class",
        "wheel_strategy",
        "stance_center_mm",
        "stance_range_mm",
        "independent_friction_brake_required"
      ],
      "properties": {
        "target_range_mi": {
          "type": "number"
        },
        "planning_installed_energy_wh": {
          "type": "number"
        },
        "selected_energy_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "wheel_strategy": {
          "type": "string"
        },
        "stance_center_mm": {
          "type": "number"
        },
        "stance_range_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "independent_friction_brake_required": {
          "type": "boolean"
        }
      }
    },
    "vendor_family": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "CURATED",
        "SYNTHESIZED"
      ]
    },
    "swap_defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "composition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "engine": {
          "const": "catalog_composer_v1"
        },
        "selection": {
          "type": "object"
        },
        "manufacturers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compatibility_states": {
          "type": "object"
        },
        "unknown_count": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "schema_version",
        "scope",
        "candidate_id",
        "summary",
        "interfaces",
        "measurement_worklist",
        "source_evidence",
        "source_maintenance",
        "price_basis",
        "score_basis",
        "authority"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "const": "non_authoritative_catalog_evidence_explorer"
        },
        "candidate_id": {
          "type": "string"
        },
        "interfaces": {
          "type": "array"
        },
        "measurement_worklist": {
          "type": "array"
        },
        "source_evidence": {
          "type": "array"
        },
        "source_maintenance": {
          "type": "array"
        },
        "price_basis": {
          "const": "KNOWN_USD_SUBTOTAL_ONLY"
        },
        "score_basis": {
          "const": "PLANNING_PREFERENCE_NOT_SAFETY"
        },
        "summary": {
          "type": "object",
          "required": [
            "open_interfaces",
            "incompatible_interfaces",
            "source_refresh_or_integrity_issues",
            "unpriced_items",
            "physical_basis"
          ]
        },
        "authority": {
          "type": "object",
          "required": [
            "procurement_authorized",
            "fabrication_authorized",
            "charging_authorized",
            "powered_operation_authorized",
            "generic_builder_may_promote_x1_authority"
          ],
          "properties": {
            "procurement_authorized": {
              "const": false
            },
            "fabrication_authorized": {
              "const": false
            },
            "charging_authorized": {
              "const": false
            },
            "powered_operation_authorized": {
              "const": false
            },
            "generic_builder_may_promote_x1_authority": {
              "const": false
            }
          }
        }
      }
    }
  }
}
