{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worcester-x1.local/schemas/board_candidate.schema.json",
  "title": "Generated board candidate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "label",
    "fit_score",
    "readiness",
    "architecture_id",
    "bom",
    "explanations",
    "blockers",
    "unknowns"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "fit_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "readiness": {
      "enum": [
        "REFERENCE_COMPATIBLE",
        "MEASURE_FIRST",
        "BLOCKED",
        "INCOMPATIBLE"
      ]
    },
    "architecture_id": {
      "type": "string"
    },
    "bom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "explanations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_preset": {
      "type": "string"
    }
  }
}
