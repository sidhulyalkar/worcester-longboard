{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worcester-x1.local/schemas/catalog_source_health.schema.json",
  "title": "Board Builder catalog source health",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "as_of",
    "source_snapshot_file",
    "thresholds",
    "valid",
    "integrity_errors",
    "warnings",
    "summary",
    "component_health",
    "geometry_visual_proxies",
    "refresh_worklist",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "const": "board_catalog_source_health"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_snapshot_file": {
      "type": "string",
      "minLength": 1
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_max_age_days",
        "refresh_due_max_age_days"
      ],
      "properties": {
        "fresh_max_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "refresh_due_max_age_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "valid": {
      "type": "boolean"
    },
    "integrity_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_components",
        "source_linked_components",
        "planning_only_components",
        "source_fresh",
        "refresh_due",
        "stale",
        "missing_provenance",
        "geometry_visual_proxies",
        "source_snapshots"
      ],
      "properties": {
        "catalog_components": {
          "type": "integer",
          "minimum": 0
        },
        "source_linked_components": {
          "type": "integer",
          "minimum": 0
        },
        "planning_only_components": {
          "type": "integer",
          "minimum": 0
        },
        "source_fresh": {
          "type": "integer",
          "minimum": 0
        },
        "refresh_due": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "missing_provenance": {
          "type": "integer",
          "minimum": 0
        },
        "geometry_visual_proxies": {
          "type": "integer",
          "minimum": 0
        },
        "source_snapshots": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "component_health": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "label",
          "category",
          "manufacturer",
          "seller",
          "procurement_state",
          "source_kind",
          "source_url",
          "snapshot_id",
          "verified_as_of",
          "age_days",
          "status",
          "reasons"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ]
          },
          "seller": {
            "type": "string",
            "minLength": 1
          },
          "procurement_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified_as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "age_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "enum": [
              "SOURCE_FRESH",
              "REFRESH_DUE",
              "STALE",
              "MISSING_PROVENANCE",
              "PLANNING_ONLY"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "geometry_visual_proxies": {
      "type": "array"
    },
    "refresh_worklist": {
      "type": "array"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stock_currently_verified",
        "procurement_authorized",
        "fabrication_authorized",
        "powered_operation_authorized",
        "source_health_may_promote_x1_authority"
      ],
      "properties": {
        "stock_currently_verified": {
          "const": false
        },
        "procurement_authorized": {
          "const": false
        },
        "fabrication_authorized": {
          "const": false
        },
        "powered_operation_authorized": {
          "const": false
        },
        "source_health_may_promote_x1_authority": {
          "const": false
        }
      }
    }
  }
}
