{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worcester-x1.local/schemas/component.schema.json",
  "title": "Board component catalog entry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "category",
    "label",
    "evidence_state",
    "procurement_state",
    "interfaces",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "base_board",
        "deck",
        "truck",
        "wheel",
        "hub",
        "axle",
        "brake",
        "drive",
        "motor",
        "esc",
        "battery",
        "charger",
        "rider_interface",
        "armor",
        "dock"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "sku": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_state": {
      "enum": [
        "QUALIFIED",
        "REFERENCE",
        "ASSUMED",
        "BLOCKED",
        "NOT_PRESENT"
      ]
    },
    "procurement_state": {
      "enum": [
        "SOURCE_ONLY",
        "HOLD_MEASURE",
        "POWER_GATED",
        "STUDY_ONLY",
        "BUY_CANDIDATE"
      ]
    },
    "interfaces": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "as_of"
      ],
      "properties": {
        "kind": {
          "enum": [
            "vendor",
            "repository_reference",
            "planning_placeholder"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "price": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
