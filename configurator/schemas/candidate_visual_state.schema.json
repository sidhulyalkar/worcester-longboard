{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worcester-x1.local/schemas/candidate_visual_state.schema.json",
  "title": "Board Builder candidate visual state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "subject_id",
    "vendor_family",
    "deck",
    "topology",
    "wheel",
    "stance_mm",
    "layers",
    "visual_style",
    "readiness",
    "checkout_state",
    "views",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "enum": [
        "candidate_preview",
        "custom_swap_preview"
      ]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manufacturer",
        "length_mm",
        "width_mm",
        "shape_family",
        "evidence_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "length_mm": {
          "type": "number",
          "minimum": 700,
          "maximum": 1300
        },
        "width_mm": {
          "type": "number",
          "minimum": 150,
          "maximum": 400
        },
        "wheelbase_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 500,
          "maximum": 1200
        },
        "tip_angle_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 60
        },
        "shape_family": {
          "type": "string",
          "minLength": 1
        },
        "evidence_state": {
          "enum": [
            "REFERENCE",
            "ASSUMED"
          ]
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manufacturer",
        "truck_total_width_mm",
        "wheel_center_lateral_mm",
        "steering_family",
        "evidence_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "truck_total_width_mm": {
          "type": "number",
          "minimum": 250,
          "maximum": 600
        },
        "wheel_center_lateral_mm": {
          "type": "number",
          "minimum": 100,
          "maximum": 300
        },
        "steering_family": {
          "type": "string",
          "minLength": 1
        },
        "axle_diameter_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 30
        },
        "evidence_state": {
          "enum": [
            "REFERENCE",
            "ASSUMED"
          ]
        },
        "visual_geometry_state": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "manufacturer",
        "wheel_class",
        "hub_family",
        "diameter_mm",
        "width_mm",
        "visible"
      ],
      "properties": {
        "study_id": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "wheel_class": {
          "type": "string"
        },
        "hub_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "diameter_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "width_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "stance_mm": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 260,
      "maximum": 520
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brake",
        "drive",
        "pack",
        "snowdeck",
        "armor",
        "dock"
      ],
      "properties": {
        "brake": {
          "type": "boolean"
        },
        "drive": {
          "type": "boolean"
        },
        "pack": {
          "type": "boolean"
        },
        "snowdeck": {
          "type": "boolean"
        },
        "armor": {
          "type": "boolean"
        },
        "dock": {
          "type": "boolean"
        }
      }
    },
    "readiness": {
      "enum": [
        "REFERENCE_COMPATIBLE",
        "MEASURE_FIRST",
        "BLOCKED",
        "INCOMPATIBLE"
      ]
    },
    "checkout_state": {
      "enum": [
        "SOURCE_LINKS",
        "HOLD_MEASURE",
        "BLOCKED"
      ]
    },
    "fit_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "cost": {
      "type": "object"
    },
    "views": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "const": "hero"
        },
        {
          "const": "top"
        },
        {
          "const": "side"
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualization_only",
        "procurement_authorized",
        "fabrication_authorized",
        "powered_operation_authorized"
      ],
      "properties": {
        "visualization_only": {
          "const": true
        },
        "procurement_authorized": {
          "const": false
        },
        "fabrication_authorized": {
          "const": false
        },
        "powered_operation_authorized": {
          "const": false
        }
      }
    },
    "vendor_family": {
      "type": "string",
      "minLength": 1
    },
    "visual_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deck_shape",
        "steering_family",
        "wheel_family",
        "brake_family",
        "drive_type"
      ],
      "properties": {
        "deck_shape": {
          "type": "string"
        },
        "steering_family": {
          "type": "string"
        },
        "wheel_family": {
          "type": "string"
        },
        "brake_family": {
          "type": "string"
        },
        "drive_type": {
          "type": "string"
        }
      }
    }
  }
}
